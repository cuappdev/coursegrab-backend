      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get or initialize the current local user",
        "operationId": "v2_get_users_me",
        "security": [
          {
            "FirebaseAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UserResponse"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "description": "Resolves Firebase UID to a local user, linking by verified email or creating the user on first use. Returns no custom session tokens. Other authenticated v2 routes perform the same user resolution."
      }
    },
    "/api/v2/users/devices/": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Register a push device",
        "operationId": "v2_post_users_devices",
        "security": [
          {
            "FirebaseAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeviceResponse"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "description": "Repeated registration of the same user/platform/token returns the existing ID. A token owned by another v2 account returns 409. Save the returned ID for rotation/logout. Registration alone does not set the user push preference or send a notification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceInput"
              }
            }
          }
        }
      }
    },
    "/api/v2/users/devices/{registration_id}/": {
      "put": {
        "tags": [
          "Devices"
        ],
        "summary": "Update an owned push registration",
        "operationId": "v2_put_users_devices_registration_id",
        "security": [
          {
            "FirebaseAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeviceResponse"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "description": "Replaces the platform/token of an owned registration. Conflicts with another registration return 409. Clears matching old legacy token copies on rotation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "registration_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "delete": {
        "tags": [
          "Devices"
        ],
        "summary": "Unregister a push device",
        "operationId": "v2_delete_users_devices_registration_id",
        "security": [
          {
            "FirebaseAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/EmptyResponse"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "description": "Call before Firebase sign-out, while you still have a valid ID token. Deletes the registration and clears matching legacy token copies. Returns data:null.",
        "parameters": [
          {
            "name": "registration_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LegacySession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Paste the session_token from /api/session/initialize/ or /api/session/update/ without the Bearer prefix. Legacy raw-token headers remain accepted by the backend. Authorization is not saved across page reloads."
      },
      "LegacyRefresh": {
        "type": "http",
        "scheme": "bearer",
        "description": "Paste the update_token without the Bearer prefix. Used only for /api/session/update/, not ordinary authenticated requests."
      },
      "FirebaseAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste a Firebase ID token from the client SDK without the Bearer prefix. Requires Google sign-in, a verified Cornell email (or an approved review account), and an enabled, non-revoked account. Not a Google OAuth token, refresh token, or push token. Authorization is not saved across page reloads."
      }
