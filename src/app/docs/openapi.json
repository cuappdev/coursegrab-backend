        "security": [],
        "responses": {
          "200": {
            "$ref": "#/components/responses/LegacyMessageResponse"
          }
        },
        "description": "Legacy unauthenticated debug endpoint. Calling it sends a real notification using the first section in the database and requires configured push credentials. The returned message is not reliable delivery confirmation: the sender does not return the numeric value this controller checks. Not available in v2.",
        "parameters": [
          {
            "name": "device_token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
